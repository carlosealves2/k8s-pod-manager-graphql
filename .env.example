# Server Configuration
PORT=8080
LOG_LEVEL=info

# Database Configuration
DATABASE_URL=postgres://postgres:postgres@localhost:5432/k8s_pod_manager?sslmode=disable

# Kubernetes Configuration
IN_CLUSTER=false
KUBECONFIG=/Users/your-user/.kube/config

# CORS Configuration
ENABLE_CORS=true
ALLOWED_ORIGINS=*

# Rate Limiting
RATE_LIMIT=100